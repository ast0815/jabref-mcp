{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "jabref": {
        "type": "local",
        "command": ["uvx", "jabref-mcp"],
        "environment": {
          // Point this at your real JabRef libraries (comma-separated).
          // The sample below makes the server work out of the box when OpenCode
          // is started from this repository.
          "JABREF_MCP_BIB_FILES": "/home/lukas/misc/JabRefMCP/tests/sample.bib"
        }
      }
    }
  }
}